{
  "name": "battlesimulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "headless": "tsx tools/headless.ts",
    "sprites:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-sprites.ps1",
    "sprites:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-sprites.ps1 -VerifyOnly",
    "sprites:check": "tsx tools/check-sprite-assets.ts",
    "effects:check": "tsx tools/check-effect-assets.ts",
    "effects:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-effects.ps1",
    "effects:list": "tsx tools/list-effect-assets.ts"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
